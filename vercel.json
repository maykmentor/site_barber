{
  "cleanUrls": true,
  "functions": {
    "api/page.js": {
      "includeFiles": "index.html"
    }
  },
  "routes": [
    {
      "src": "^/index(?:\\.html)?$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/layout(?:\\.html)?$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/$",
      "dest": "/api/page"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/api/robots"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap"
    },
    {
      "src": "^/admin$",
      "dest": "/admin.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
